# SONARIS-X Marine Acoustic Intelligence - Map Configuration
# Configurable map tile and style endpoints (browser-safe public tokens only)

# Primary Dark Tactical Basemap (Default: CARTO Dark Matter)
VITE_MAP_TILE_URL=https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png

# Optional High-Resolution Satellite / Aerial Imagery Layer (Configured with User Google Maps Key)
VITE_MAP_SATELLITE_URL=https://mt{s}.google.com/vt/lyrs=y&x={x}&y={y}&z={z}&key=AIzaSyDJlWuel9pbfnbh375QP1dvXEZMFFJ_srU

# Alternative Vector Style URL (if using custom MapLibre / vector style JSON endpoint)
VITE_MAP_STYLE_URL=

# Public Map Provider API Key (Google Maps API Key provided by user)
VITE_MAP_API_KEY=AIzaSyDJlWuel9pbfnbh375QP1dvXEZMFFJ_srU

# Map Attribution String
VITE_MAP_ATTRIBUTION=&copy; Google Maps &copy; OpenStreetMap contributors &copy; CARTO
