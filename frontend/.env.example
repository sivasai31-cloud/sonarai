# SONARIS-X Marine Acoustic Intelligence - Map Configuration
# Configurable map tile and style endpoints (browser-safe public tokens only)

# Primary Dark Tactical Basemap (Default: CARTO Dark Matter)
VITE_MAP_TILE_URL=https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png

# Optional High-Resolution Satellite / Aerial Imagery Layer (Default: Esri World Imagery)
VITE_MAP_SATELLITE_URL=https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}

# Alternative Vector Style URL (if using custom MapLibre / vector style JSON endpoint)
VITE_MAP_STYLE_URL=

# Public Map Provider API Key (if using services like MapTiler, Stadia, or Mapbox)
# DO NOT place server-side secret keys here.
VITE_MAP_API_KEY=

# Map Attribution String
VITE_MAP_ATTRIBUTION=&copy; OpenStreetMap contributors &copy; CARTO
